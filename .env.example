# doubao-2api 环境变量配置模板
# ====================================================================
# 使用说明：
#   1. 复制此文件为 .env：  cp .env.example .env
#   2. 按照下方指引，从浏览器抓包中提取各项配置值并填入 .env
#   3. 注意：所有包含 $ 符号的 Cookie 值，必须将 $ 替换为 $$（Docker Compose 变量转义）
# ====================================================================

# --- 核心安全配置 (必须修改) ---
# 用于保护您 API 服务的访问密钥。请务必修改为您自己的复杂密钥。
API_MASTER_KEY="sk-your-very-strong-secret-key-here"

# --- 部署配置 ---
# Nginx 对外暴露的端口，可根据需要修改
NGINX_PORT=8088

# --- 豆包 Cookie 凭证 (支持多账号) ---
# ⚠️ 关键：Cookie 中若包含 $ 字符，必须写为 $$ （Docker Compose 会将其解释为变量）
# 例如：_ga_G8EP5CG8VZ=GS2.1.s1766051380$o198$g0... → 必须写成 ...s1766051380$$o198$$g0...
#
# 获取方法：
#   1. 使用 Chrome/Edge 浏览器登录 https://www.doubao.com/chat/
#   2. 按 F12 打开开发者工具 → Console 标签
#   3. 输入 document.cookie 并回车，复制输出的完整字符串
#   4. 粘贴到下方 DOUBAO_COOKIE_1 的引号内
#   5. 检查其中是否包含 $ 字符，若有，全部替换为 $$
#
# 多账号轮询：添加 DOUBAO_COOKIE_2、DOUBAO_COOKIE_3 ...
DOUBAO_COOKIE_1="paste_your_full_cookie_string_here"

# --- 静态设备指纹 (必填) ---
# 这 4 个值必须与 Cookie 来自同一次浏览器会话，否则签名将失败。
# 获取方法详见本文件末尾的 [设备指纹提取指南]。
#
# DOUBAO_DEVICE_ID  - 设备唯一标识（19 位数字）
#   提取方法 A（推荐）：在浏览器 DevTools → Network 中，找到任意 API 请求，
#   在 Query String Parameters 中查找 device_id 字段。
#   提取方法 B：从 LARK_SUITE_ACCESS_TOKEN 的 JWT Payload 中解码，
#   找到 session_extra.web_device_id 字段。JWT 可在 https://jwt.io 在线解码。
#
# DOUBAO_FP  - 浏览器指纹（verify_ 开头）
#   提取方法：从 Cookie 中提取 s_v_web_id 的值；
#   或在 Network 中查看 API 请求的 Query String Parameters → fp 字段。
#
# DOUBAO_TEA_UUID  - 设备 Tea UUID（19 位数字）
#   提取方法：从 Cookie 中提取 __tea__ug__uid 的值；
#   或在 Network 中查看 API 请求的 Query String Parameters → tea_uuid 字段。
#
# DOUBAO_WEB_ID  - Web 设备 ID（通常与 DOUBAO_TEA_UUID 相同）
#   提取方法：在 Network 中查看 API 请求的 Query String Parameters → web_id 字段；
#   通常与 tea_uuid 值相同。
DOUBAO_DEVICE_ID=0
DOUBAO_FP=verify_
DOUBAO_TEA_UUID=0
DOUBAO_WEB_ID=0

# --- 会话管理 (可选) ---
# 对话历史在内存中的缓存时间（秒），默认 1 小时
SESSION_CACHE_TTL=3600


# ====================================================================
#                  设备指纹详细提取指南
# ====================================================================
#
# 背景：豆包使用 a_bogus 签名机制保护 API。签名依赖于 4 个设备指纹参数，
# 这些参数必须与请求中携带的 Cookie 来自同一浏览器会话，否则签名验证失败。
#
# ┌─────────────────────────────────────────────────────────────────┐
# │  方法一：从浏览器 Network 面板提取（最准确、最推荐）             │
# ├─────────────────────────────────────────────────────────────────┤
# │ 1. 登录 https://www.doubao.com/chat/                           │
# │ 2. F12 → Network → 发送一条消息                                  │
# │ 3. 筛选 XHR/Fetch 请求，找到任意包含 "completion" 的请求          │
# │ 4. 点击该请求 → Payload → Query String Parameters               │
# │ 5. 复制以下字段的值：                                            │
# │    · device_id   → 填入 DOUBAO_DEVICE_ID                        │
# │    · fp          → 填入 DOUBAO_FP                               │
# │    · tea_uuid    → 填入 DOUBAO_TEA_UUID                         │
# │    · web_id      → 填入 DOUBAO_WEB_ID                           │
# └─────────────────────────────────────────────────────────────────┘
#
# ┌─────────────────────────────────────────────────────────────────┐
# │  方法二：从 Cookie 和 JWT 中提取（次选，适用于无 Network 抓包）  │
# ├─────────────────────────────────────────────────────────────────┤
# │ DOUBAO_TEA_UUID: Cookie 中 __tea__ug__uid 的值                  │
# │ DOUBAO_FP:       Cookie 中 s_v_web_id 的值                      │
# │ DOUBAO_WEB_ID:   通常与 DOUBAO_TEA_UUID 相同                     │
# │ DOUBAO_DEVICE_ID: 需要解码 LARK_SUITE_ACCESS_TOKEN 的 JWT       │
# │   1. 从 Cookie 中复制 LARK_SUITE_ACCESS_TOKEN 的完整值            │
# │   2. 访问 https://jwt.io 粘贴解码                                │
# │   3. 在 PAYLOAD 中找到 session_extra.web_device_id              │
# │   4. 将该值填入 DOUBAO_DEVICE_ID                                 │
# │                                                                 │
# │ ⚠️ 注意：方法二提取的 device_id 可能不够精确，若遇到             │
# │    rate limited / slide 验滑验证，请使用方法一。                  │
# └─────────────────────────────────────────────────────────────────┘
#
# ┌─────────────────────────────────────────────────────────────────┐
# │  故障排查                                                        │
# ├─────────────────────────────────────────────────────────────────┤
# │ · "等待签名函数超时"                                             │
# │   → Cookie 无效或已过期，需重新抓包                               │
# │ · "rate limited" / "slide" 滑块验证                              │
# │   → 设备指纹与 Cookie 不匹配，或 IP 被限流                        │
# │ · Docker Compose 警告 "$xxx is not set"                         │
# │   → Cookie 中的 $ 未转义为 $$                                    │
# │ · 签名函数命名空间变更                                           │
# │   → 本项目 v1.1 已兼容 bdms.frontierSign (新) 和                  │
# │     byted_acrawler.frontierSign (旧)                             │
# └─────────────────────────────────────────────────────────────────┘
